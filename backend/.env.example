# Environment
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/sports_platform?schema=public"

# JWT Secrets (use strong random strings in production)
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-here

# JWT Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
